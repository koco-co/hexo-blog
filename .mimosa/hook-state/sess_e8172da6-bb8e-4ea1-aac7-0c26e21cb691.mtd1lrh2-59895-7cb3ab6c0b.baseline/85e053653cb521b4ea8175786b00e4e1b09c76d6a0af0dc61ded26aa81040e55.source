async (page) => {
  page.setDefaultTimeout(10000);
  const out={url:page.url(),images:[],views:[],counts:{}};
  const imgs=page.locator('#article-container img');
  for(let i=0;i<await imgs.count();i++){
    const im=imgs.nth(i);
    await im.scrollIntoViewIfNeeded();
    await im.evaluate(el=>new Promise((resolve,reject)=>{
      const t=Date.now(), poll=()=>el.complete&&el.naturalWidth>1?resolve():Date.now()-t>12000?reject(Error('image timeout')):setTimeout(poll,100);
      poll();
    }));
    out.images.push(await im.evaluate(el=>({src:el.currentSrc,alt:el.alt,width:el.naturalWidth})));
  }
  const card=page.locator('[data-card-id="testing-basics-scenario-password-login"]');
  await card.scrollIntoViewIfNeeded();
  const before=await card.getAttribute('aria-pressed');
  await card.click();
  const flipped=await card.getAttribute('aria-pressed');
  await card.press('Enter');
  const keyboard=await card.getAttribute('aria-pressed');
  await card.press('Enter');
  out.card={before,flipped,keyboard,final:await card.getAttribute('aria-pressed')};
  for(const [name,width,height,theme,target] of [['desktop-light',1280,900,'light','card'],['desktop-dark',1280,900,'dark','card'],['mobile-dark',390,844,'dark','diagram'],['mobile-light',390,844,'light','diagram']]){
    await page.setViewportSize({width,height});
    if(await page.evaluate(()=>document.documentElement.dataset.theme)!==theme){
      if(!await page.locator('#rightside-config-hide').evaluate(el=>el.classList.contains('show')))await page.getByRole('button',{name:'设置',exact:true}).click();
      await page.getByRole('button',{name:'日间和夜间模式切换',exact:true}).click();
      await page.waitForFunction(t=>document.documentElement.dataset.theme===t,theme);
    }
    await (target==='card'?card:page.locator('.mermaid-wrap svg')).scrollIntoViewIfNeeded();
    const dims=await page.evaluate(()=>({client:document.documentElement.clientWidth,scroll:document.documentElement.scrollWidth}));
    if(dims.client!==dims.scroll)throw Error('overflow '+name);
    await page.screenshot({path:'/tmp/a06-root-'+name+'.png',scale:'css',animations:'disabled'});
    out.views.push({name,...dims,theme:await page.evaluate(()=>document.documentElement.dataset.theme)});
  }
  out.counts={headings:await page.locator('#article-container h2,#article-container h3').count(),cards:await page.locator('#article-container [data-card-id]').count(),mermaid:await page.locator('.mermaid-wrap svg').count()};
  return out;
}
